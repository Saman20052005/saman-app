# ==============================================================================
# Saman App Backend — Environment Variables Template
# Copy to `.env` for local development or configure in Cloud dashboard (Render /
# Railway / Fly.io). NEVER commit real secrets to version control.
# ==============================================================================

# --- Runtime & Server ---
# Environment mode: development | production
ENVIRONMENT=production
# Listening port (automatically injected by Render/Railway/Fly.io)
PORT=8000
# Comma-separated list of allowed CORS origins (e.g. https://saman.app,https://admin.saman.app)
CORS_ORIGINS=https://saman.app
# Optional single frontend origin fallback when CORS_ORIGINS is empty
FRONTEND_URL=https://saman.app
# Logging verbosity: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# --- MongoDB Atlas ---
# MongoDB Atlas SRV connection string (uses TLS with certifi CA bundle)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Target MongoDB database name
DB_NAME=saman_fitness

# --- Authentication & OAuth ---
# High-entropy secret key used to sign/verify JWT access tokens
JWT_SECRET=replace-with-a-strong-random-secret-at-least-32-chars
# JWT signing algorithm (default: HS256)
JWT_ALGORITHM=HS256
# Google OAuth 2.0 Web Client ID for verifying Google Sign-In ID tokens
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# --- Gemini AI & Food Analysis ---
# Google Gemini API key for AI Coach chat and Gemini Food Analysis
GEMINI_API_KEY=your-gemini-api-key
# Enable Gemini-powered food photo & nutrition label analysis
ENABLE_GEMINI_FOOD_ANALYSIS=true
# Food analysis engine: gemini | ensemble | mock
FOOD_ANALYSIS_PROVIDER=gemini
# Optional model overrides
GEMINI_SWIFT_MODEL=gemini-2.5-flash-lite
GEMINI_CORE_MODEL=gemini-2.5-flash
GEMINI_PRO_MODEL=gemini-2.5-pro
GEMINI_ENABLE_THINKING_CONFIG=auto
GEMINI_FOOD_MODEL=gemini-2.5-flash
GEMINI_FOOD_FALLBACK_MODEL=gemini-2.5-flash-lite
# Timeout (seconds) for AI requests
AI_TIMEOUT_SECONDS=30
# Local classifier provider (keep mock on CPU/free-tier cloud instances)
FOOD_CLASSIFIER_PROVIDER=mock
MOCK_CLASSIFIER_MODE=normal

# --- Paywall & Revenue ---
# Enforce AI membership paywall and quota reservations
ENABLE_AI_PAYWALL=true
# Revenue enforcement flags
REVENUE_ENFORCEMENT_ENABLED=true
REVENUE_SHADOW_MODE=false

# --- PayOS / VietQR Payments ---
# PayOS merchant credentials (from https://my.payos.vn)
PAYOS_CLIENT_ID=your-payos-client-id
PAYOS_API_KEY=your-payos-api-key
PAYOS_CHECKSUM_KEY=your-payos-checksum-key
# Optional PayOS callback URLs & API base URL
PAYOS_RETURN_URL=https://saman.app/payment/success
PAYOS_CANCEL_URL=https://saman.app/payment/cancel
PAYOS_BASE_URL=https://api-merchant.payos.vn

# --- Object Storage / Media (S3 / Cloudflare R2) ---
MEDIA_STORAGE_PROVIDER=local
ALLOW_LOCAL_MEDIA_STORAGE=false
S3_ENDPOINT_URL=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# --- Media Storage (Cloudinary) ---
# Cloudinary credentials for avatar and community image uploads
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
# Disable ephemeral local avatar storage in production cloud containers
ALLOW_LOCAL_AVATAR_STORAGE=false

# --- Optional / Email & Secondary Providers ---
# SMTP credentials for OTP / password reset emails
EMAIL_ADDRESS=no-reply@saman.app
EMAIL_PASSWORD=your-smtp-app-password
# Optional HuggingFace model download settings (only if using local PyTorch classifier)
HF_MODEL_ID=
HF_TOKEN=
