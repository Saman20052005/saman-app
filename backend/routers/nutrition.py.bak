# ===== LEGACY ENDPOINTS (Keep for compatibility) =====
@router.get("/{date}")
async def get_nutrition_by_date(
    date: str,
    email: str = Depends(verify_token)
):
    """Get nutrition data for a specific date (Legacy)"""
