        user = user_repo.get_by_email(email)
        if not user:
            raise HTTPException(status_code=404, detail="User not found")
        
        # For now, return mock data
        # TODO: Implement actual nutrition data retrieval from database
        return {
            "date": date,
            "entries": [],
            "total_calories": 0,
            "total_protein": 0.0,
            "total_carbs": 0.0,
            "total_fat": 0.0,
            "message": "Mock data - implement database integration"
        }
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))

@router.post("/generate-plan")
async def generate_nutrition_plan(
    request: NutritionPlanRequest,
    email: str = Depends(verify_token)
):
    """Generate personalized nutrition plan"""
    try:
        user = user_repo.get_by_email(email)
        if not user:
            raise HTTPException(status_code=404, detail="User not found")
        
        # Generate meal plan
        meal_plan = meal_generator.generate_daily_plan(
            target_calories=request.target_calories,
            dietary_preferences=request.dietary_preferences,
            allergies=request.allergies,
            goal=request.goal
        )
        
        return {
            "plan": meal_plan,
            "generated_at": datetime.now().isoformat(),
            "user_preferences": {
                "target_calories": request.target_calories,
                "dietary_preferences": request.dietary_preferences,
                "allergies": request.allergies,
                "goal": request.goal
            }
        }
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))

@router.get("/report/weekly")
async def get_weekly_nutrition_report(
    start_date: Optional[str] = Query(None),
    email: str = Depends(verify_token)
):
    """Get weekly nutrition report"""
    try:
        user = user_repo.get_by_email(email)
        if not user:
            raise HTTPException(status_code=404, detail="User not found")
        
        # Default to last 7 days if no start date provided
        if not start_date:
            start_date = (date.today() - timedelta(days=7)).isoformat()
        
        # For now, return mock data
        # TODO: Implement actual weekly report generation
        return {
            "period": {
                "start_date": start_date,
                "end_date": (date.fromisoformat(start_date) + timedelta(days=6)).isoformat()
            },
            "summary": {
                "avg_daily_calories": 0,
                "avg_daily_protein": 0.0,
                "avg_daily_carbs": 0.0,
                "avg_daily_fat": 0.0,
                "total_days_tracked": 0
            },
            "daily_data": [],
            "message": "Mock data - implement database integration"
        }
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))

